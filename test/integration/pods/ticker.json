{
  "pod": {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "ticker",
      "namespace": "default",
      "uid": "11111111-0000-4000-8000-000000000005"
    },
    "spec": {
      "containers": [
        {
          "name": "main",
          "image": "alpine:3.20",
          "command": ["sh", "-c"],
          "args": ["for i in $(seq 1 12); do echo tick $i; sleep 2; done; echo ticker done"]
        }
      ]
    }
  },
  "container": [{"name": "main"}]
}
